{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    "paths": {
      "store/*": ["store/*"],
      "screen/*": ["screen/*"],
      "utils/*": ["utils/*"],
      "components/*": ["components/*"],
      "hooks/*": ["hooks/*"],
      "modals/*": ["modals/*"],
      "services/*": ["services/*"]
    }
  },
  "extends": "@react-native/typescript-config/tsconfig.json"
}